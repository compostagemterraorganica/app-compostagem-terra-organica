{
  "cli": {
    "version": ">= 13.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "buildConfiguration": "Debug"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "env": {
        "APP_ENV": "production",
        "APP_ENVIRONMENT": "production",
        "DEBUG_MODE": "false",
        "LOG_LEVEL": "error",
        "ENABLE_CONSOLE_LOGS": "false",
        "API_BASE_URL": "https://api-terraorganica-production.up.railway.app",
        "YOUTUBE_UPLOAD_URL": "https://api-terraorganica-production.up.railway.app/youtube/upload",
        "APP_NAME": "Terra Orgânica",
        "APP_VERSION": "1.0.1",
        "DEEP_LINK_SCHEME": "terraorganica",
        "DEEP_LINK_HOST": "app",
        "STORAGE_PREFIX": "terra_organica_",
        "API_TIMEOUT": "30000",
        "UPLOAD_TIMEOUT": "300000",
        "MAX_VIDEO_DURATION": "300",
        "VIDEO_QUALITY": "720p",
        "VIDEO_FORMAT": "mp4",
        "LOCATION_ACCURACY": "high",
        "LOCATION_TIMEOUT": "15000",
        "LOCATION_MAX_AGE": "10000"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "env": {
          "EXPO_USE_COMMUNITY_AUTOLINKING": "0"
        }
      },
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      },
      "channel": "production",
      "distribution": "internal"
    },
    "production-aab": {
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      },
      "autoIncrement": true,
      "channel": "production",
      "distribution": "store"
    }
  },
  "submit": {
    "production": {}
  }
}

