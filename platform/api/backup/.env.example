# Servidor HTTP (health + trigger manual)
PORT=3010
NODE_ENV=development
LOG_LEVEL=info

# Banco da API principal (mesma URL do platform/api)
POSTGRES_URL=postgresql://postgres:password@localhost:5432/postgres

# Amazon S3 — destino dos backups
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=terraorganica
# Prefixo raiz no bucket (pastas datadas ficam abaixo).
# Usa media/backups para compatibilidade com a policy IAM de midia.
S3_BACKUP_PREFIX=media/backups

# Cron (sexta-feira 22:00 no fuso configurado)
BACKUP_CRON_ENABLED=true
BACKUP_CRON_SCHEDULE=0 22 * * 5
BACKUP_CRON_TZ=America/Sao_Paulo

# Token opcional para POST /backup (se vazio, endpoint exige Header Authorization: Bearer <token> desativado em dev)
BACKUP_TRIGGER_TOKEN=

# Manter copia local em tmp/ apos upload (true|false)
BACKUP_KEEP_LOCAL=false
