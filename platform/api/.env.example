PORT=3000
NODE_ENV=development

# Logs (Railway: ver Deployments > Logs)
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=debug
# REQUEST_LOG_BODY=false para omitir corpo JSON nos logs
REQUEST_LOG_BODY=true

POSTGRES_URL=postgresql://postgres:password@localhost:5432/postgres
# Railway: POSTGRES_URL=${{Postgres.DATABASE_URL}} ou omita e use DATABASE_URL (fallback automatico)

# Destino para clonagem completa do banco (npm run db:backup-restore)
NEW_POSTGRES_URL=postgresql://postgres:password@localhost:5432/postgres_destino

# Opcional: pasta local dos arquivos .dump (padrao: scripts/backups)
# POSTGRES_BACKUP_DIR=/caminho/para/backups

# Origens permitidas no CORS (separadas por vírgula). Inclua a URL do Vite/web (5173 ou 5900).
APP_ORIGIN=http://localhost:5173,http://localhost:5900,http://localhost:19006
# Dev LAN (app no celular via IP): deixe COOKIE_DOMAIN vazio e COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=terra_session
CSRF_COOKIE_NAME=terra_csrf

# Chave usada para assinar tokens de sessão no cookie
SESSION_SECRET=change-me-with-random-strong-secret

# Pepper usado no hash das senhas em users.password (troque em produção)
PASSWORD_HASH_KEY=9f4ed29293d404dc9b4c0e2ef5ec6b654e3ec784f593508e64b7f6f0584fdb7a

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/youtube/oauth/callback
YOUTUBE_REFRESH_TOKEN=

# Amazon SES — emails transacionais (verificacao, convites)
# IAM minimo: ses:SendEmail, ses:SendRawEmail
# Testar: npm run test:ses
SES_FROM=Terra Organica <app@compostagemterraorganica.com.br>
SES_TEST_TO=
SES_TEST_SKIP_SEND=false

# E-mail que recebe notificacao quando um formulario publico e enviado (contato, financiador, cadastro de central)
# Deixe vazio para desativar. Requer SES configurado (AWS_REGION + SES_FROM).
FORM_NOTIFICATION_EMAIL=contato@compostagemterraorganica.com.br

AUTH_CODE_TTL_MINUTES=15
AUTH_CODE_MAX_ATTEMPTS=5

# Link ficticio/planejado para download do app (email de convite)
APP_DOWNLOAD_URL=https://compostagemterraorganica.com.br/app/download

# URL do painel administrativo (email de convite admin). Padrao: primeira origem em APP_ORIGIN + /admin/entrar
# ADMIN_PANEL_URL=https://compostagemterraorganica.com.br/admin/entrar

# -----------------------------------------------------------------------------
# Amazon S3 (mídia do CMS)
# -----------------------------------------------------------------------------
#
# Credencial: usuário IAM com s3:PutObject, s3:GetObject, s3:DeleteObject no bucket.
# HeadObject é autorizado via s3:GetObject (não existe ação s3:HeadObject no IAM).
#
# Testar conexão após preencher as variáveis:
#   npm run test:s3

AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Nome do bucket
S3_BUCKET=terraorganica-media

# URL pública base dos objetos (sem barra no final)
# Ex: https://NOME_DO_BUCKET.s3.sa-east-1.amazonaws.com
# Ou URL do CloudFront / domínio customizado
S3_PUBLIC_BASE=https://terraorganica-media.s3.sa-east-1.amazonaws.com

# Prefixo das chaves de mídia no bucket (pasta lógica flat)
S3_MEDIA_PREFIX=media

# Script de teste: apagar arquivo de teste após upload (true|false, padrão true)
S3_TEST_CLEANUP=true
