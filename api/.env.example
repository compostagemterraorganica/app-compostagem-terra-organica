PORT=3000
NODE_ENV=development

POSTGRES_URL=postgresql://postgres:password@localhost:5432/postgres

# Origens permitidas no CORS (separadas por vírgula). Inclua a URL do Vite (5173).
APP_ORIGIN=http://localhost:5173,http://localhost:19006
# Dev LAN (app no celular via IP): deixe COOKIE_DOMAIN vazio e COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=terra_session
CSRF_COOKIE_NAME=terra_csrf

# Chave usada para assinar tokens de sessão no cookie
SESSION_SECRET=change-me-with-random-strong-secret

# Pepper usado no hash das senhas em users.password (troque em produção)
PASSWORD_HASH_KEY=9f4ed29293d404dc9b4c0e2ef5ec6b654e3ec784f593508e64b7f6f0584fdb7a

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/youtube/oauth/callback
YOUTUBE_REFRESH_TOKEN=

# Resend — emails de verificacao (https://resend.com/)
RESEND_API_KEY=
RESEND_FROM=Terra Organica <noreply@compostagemterraorganica.com.br>
AUTH_CODE_TTL_MINUTES=15
AUTH_CODE_MAX_ATTEMPTS=5

# Link ficticio/planejado para download do app (email de convite)
APP_DOWNLOAD_URL=https://compostagemterraorganica.com.br/app/download

# -----------------------------------------------------------------------------
# Google Cloud Storage (mídia do CMS — plano de migração)
# -----------------------------------------------------------------------------
#
# Tipo de credencial necessária: Service Account (chave JSON)
#
# Como gerar no Google Cloud Console:
#   1. IAM e administração → Contas de serviço → Criar conta de serviço
#      Nome sugerido: terraorganica-media-uploader
#   2. Conceder papéis (mínimo para upload + leitura de metadados):
#      - "Storage Object Admin" no bucket (recomendado para dev)
#      OU papéis mais restritos no bucket:
#      - "Storage Object Creator" + "Storage Object Viewer"
#   3. Na conta de serviço → Chaves → Adicionar chave → Criar nova chave → JSON
#   4. Salve o arquivo FORA do repositório (ex: ~/.config/gcp/terraorganica-media.json)
#   5. NUNCA commite o JSON no git
#
# Bucket:
#   1. Cloud Storage → Criar bucket (ex: terraorganica-media)
#   2. Região: mesma do deploy (ex: southamerica-east1)
#   3. Para URLs públicas diretas (plano v1):
#      - Acesso uniforme em nível de bucket: ativado
#      - Conceder allUsers → "Leitor de objetos do Storage" no bucket
#        (ou restringir depois via CDN)
#
# Testar conexão após preencher as variáveis:
#   npm run test:gcs

# Nome do bucket (sem gs://)
GCS_BUCKET=terraorganica-media

# URL pública base dos objetos (sem barra no final)
# Formato: https://storage.googleapis.com/NOME_DO_BUCKET
GCS_PUBLIC_BASE=https://storage.googleapis.com/terraorganica-media

# Caminho absoluto para o arquivo JSON da service account
GOOGLE_APPLICATION_CREDENTIALS=/caminho/absoluto/para/terraorganica-media-sa.json

# Prefixo das chaves de mídia no bucket (pasta lógica flat)
GCS_MEDIA_PREFIX=media

# Script de teste: apagar arquivo de teste após upload (true|false, padrão true)
GCS_TEST_CLEANUP=true
